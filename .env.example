# Copy this file to ".env" (Command Prompt:  copy .env.example .env   then   notepad .env), fill in your values, save.
# The app reads .env every time it starts, so you don't have to type "set ..." in each new window.
# On Vercel you enter the same names in Project > Settings > Environment Variables instead. Never share or commit real values.

# Neon: the *pooled* connection string, with the password shown. Leave blank to use a local file (testing only).
DATABASE_URL=
# Brevo: API key + a sender address you verified in Brevo. Leave blank to print emails in the window instead.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Letters Left Unsent
# Your site's address, used inside the emailed links (http://127.0.0.1:8000 locally, your vercel.app address when deployed)
BASE_URL=http://127.0.0.1:8000
